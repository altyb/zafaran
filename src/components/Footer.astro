---
import Logo from './Logo.astro';
import { getDict, site, localePath, whatsappUrl } from '../lib/dict';
import type { Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
const link = 't-small transition-colors duration-300 hover:text-saffron-deep';
---
<footer class="bg-fg pt-14 pb-28 text-page/60 md:pb-8">
  <div class="container-page">
    <div class="grid gap-8 md:grid-cols-[2fr_1fr_1fr]">
      <p class="font-serif text-2xl italic text-page md:text-3xl rtl:font-serif-ar rtl:not-italic">{d.footer.blurb}</p>
      <nav aria-labelledby="footer-explore">
        <h2 id="footer-explore" class="t-eyebrow !text-saffron">{d.footer.explore}</h2>
        <ul class="mt-4 space-y-2">
          {d.nav.links.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="t-eyebrow !text-saffron">{d.footer.contact}</h2>
        <ul class="mt-4 space-y-2">
          <li><a href={`tel:${site.phoneE164}`} class={link} dir="ltr">{site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`} class={link} dir="ltr">{site.email}</a></li>
          <li><a href={site.instagramUrl} target="_blank" rel="noopener" class={link} dir="ltr">{d.visit.contact.instagramLabel}</a></li>
          <li><a href={whatsappUrl(locale)} target="_blank" rel="noopener" class={link}>{d.visit.contact.whatsappLabel}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-center gap-4 text-saffron">
      <Logo class="w-44 md:w-56 [--thread:var(--color-page)]" />
      <p class="t-wordmark text-3xl text-page">{d.common.brand}</p>
    </div>

    <div class="mt-6 flex flex-col gap-3 border-t border-page/15 pt-6 md:flex-row md:justify-between">
      <p class="t-small">{d.footer.copyright}</p>
      <ul class="flex gap-6">
        <li><a href={localePath(locale, 'privacy/')} class={link}>{d.footer.privacy}</a></li>
        <li><a href={localePath(locale, 'terms/')} class={link}>{d.footer.terms}</a></li>
      </ul>
    </div>
  </div>
</footer>
