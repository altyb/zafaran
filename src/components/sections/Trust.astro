---
import Icon from '../Icon.astro';
import { getDict } from '../../lib/dict';
import type { Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
---
<!-- Ticket band: notches cut from both sides, cells split by a dashed tear line. -->
<section id="trust" class="px-2 md:px-3">
  <h2 class="sr-only">{d.trust.ratingLabel}</h2>
  <ul class="ticket grid grid-cols-2 rounded-[2rem] bg-surface md:grid-cols-4 [--ny:50%]">
    {d.trust.items.map((item, i) => (
      <li
        class:list={[
          'px-6 py-8 md:px-8',
          i % 2 === 1 && 'border-s border-dashed border-line',
          i >= 2 && 'border-t border-dashed border-line md:border-t-0',
          i === 2 && 'md:border-s',
        ]}
        data-reveal
      >
        <p class="t-price flex items-center gap-2 text-lg text-fg">
          {item.icon === 'star' && <Icon name="star" class="size-5 text-saffron" />}
          {item.value}
        </p>
        <p class="t-small mt-2">{item.label}</p>
      </li>
    ))}
  </ul>
</section>
