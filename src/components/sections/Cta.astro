---
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import { getDict, site, whatsappUrl } from '../../lib/dict';
import type { Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);

// The label holds a phone number ("Call +1 202 555 0199"). Split at the '+' so
// the number can be bidi-isolated — otherwise Arabic reorders the plus sign.
const [callLabel, callNumber = ''] = d.cta.secondary.split(/(?=\+)/);
---
<section id="cta" class="relative isolate overflow-hidden">
  <Photo
    id={d.cta.photo.id}
    alt={d.cta.photo.alt}
    ratio="16/9"
    sizes="100vw"
    class="absolute inset-0 -z-10 size-full object-cover"
  />
  <!-- Flat scrim, never a gradient. -->
  <div class="absolute inset-0 -z-10 bg-scrim"></div>

  <div class="container-page py-24 md:py-32">
    <div class="max-w-[680px]">
      <p class="t-eyebrow" data-reveal>{d.cta.eyebrow}</p>
      <h2 class="t-h2 mt-2 text-fg" data-reveal>{d.cta.title}</h2>
      <p class="t-lead mt-4 text-fg" data-reveal>{d.cta.lead}</p>

      <div class="mt-8 flex flex-wrap gap-4" data-reveal>
        <a href={whatsappUrl(locale)} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
          {d.cta.primary}
          <Icon name="whatsapp-logo" class="size-5" />
        </a>
        <a href={`tel:${site.phoneE164}`} class="btn btn-secondary btn-lg">
          <Icon name="phone" class="size-5" />
          {callLabel}{callNumber && <span dir="ltr" class="inline-block">{callNumber}</span>}
        </a>
      </div>

      <p class="t-small mt-8 text-fg-muted" data-reveal>{d.cta.fallback}</p>
    </div>
  </div>
</section>
