---
import Icon from '../Icon.astro';
import { getDict, site, whatsappUrl } from '../../lib/dict';
import type { Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
const v = d.visit;
// Each card's icon sits in a bite cut from its top corner.
const card = 'relative rounded-[1.75rem] rounded-se-none bg-surface p-6 pt-20';
const badge = 'bite bite-te p-2 [--r:1rem]';
const dot = 'flex size-11 items-center justify-center rounded-full bg-saffron text-ink';
const link = 'inline-flex items-center gap-2 transition-colors duration-700 ease-fluid hover:text-saffron';
---
<section id="visit" class="section-y">
  <div class="container-page">
    <div data-reveal>
      <p class="t-eyebrow">{v.eyebrow}</p>
      <h2 class="t-h2 mt-2 text-fg">{v.title}</h2>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 md:mt-12 lg:grid-cols-4">
      <div class={card} data-reveal>
        <span class={badge}><span class={dot}><Icon name="clock" class="size-5" /></span></span>
        <h3 class="t-h3 text-fg">{v.hours.title}</h3>
        <dl class="mt-4 space-y-2">
          {v.hours.rows.map((row) => (
            <div>
              <dt class="t-small">{row.days}</dt>
              <dd class="t-body text-fg tabular-nums">
                <span dir="ltr" class="inline-block">{row.time}</span>
              </dd>
            </div>
          ))}
        </dl>
        <p class="t-small mt-4">{v.hours.note}</p>
      </div>

      <div class={card} data-reveal>
        <span class={badge}><span class={dot}><Icon name="map-pin" class="size-5" /></span></span>
        <h3 class="t-h3 text-fg">{v.address.title}</h3>
        <address class="t-body mt-4">
          {v.address.lines.map((l) => <span class="block">{l}</span>)}
        </address>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href={site.mapsGoogle} target="_blank" rel="noopener" class={`t-small rounded-full bg-white/5 px-3 py-1.5 ${link}`}>
            {v.address.google}
            <Icon name="arrow-up-right" class="size-4" mirror />
          </a>
          <a href={site.mapsApple} target="_blank" rel="noopener" class={`t-small rounded-full bg-white/5 px-3 py-1.5 ${link}`}>
            {v.address.apple}
            <Icon name="arrow-up-right" class="size-4" mirror />
          </a>
        </div>
      </div>

      <div class={card} data-reveal>
        <span class={badge}><span class={dot}><Icon name="phone" class="size-5" /></span></span>
        <h3 class="t-h3 text-fg">{v.contact.title}</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href={`tel:${site.phoneE164}`} class={`t-small ${link}`}>
              <Icon name="phone" class="size-4" />
              <span dir="ltr" class="inline-block">{v.contact.phoneLabel}</span>
            </a>
          </li>
          <li>
            <a href={whatsappUrl(locale)} target="_blank" rel="noopener" class={`t-small ${link}`}>
              <Icon name="whatsapp-logo" class="size-4" />
              {v.contact.whatsappLabel}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class={`t-small ${link}`}>
              <Icon name="envelope-simple" class="size-4" />
              <span dir="ltr" class="inline-block">{v.contact.emailLabel}</span>
            </a>
          </li>
          <li>
            <a href={site.instagramUrl} target="_blank" rel="noopener" class={`t-small ${link}`}>
              <Icon name="instagram-logo" class="size-4" />
              <span dir="ltr" class="inline-block">{v.contact.instagramLabel}</span>
            </a>
          </li>
        </ul>
      </div>

      <div class={card} data-reveal>
        <span class={badge}><span class={dot}><Icon name="car" class="size-5" /></span></span>
        <h3 class="t-h3 text-fg">{v.parking.title}</h3>
        <p class="t-small mt-4">{v.parking.body}</p>
      </div>
    </div>
  </div>
</section>
