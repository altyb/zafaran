---
import Photo from '../Photo.astro';
import { getDict, formatPrice } from '../../lib/dict';
import type { Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
---
<section id="menu" class="section-y">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <p class="t-eyebrow">{d.menu.eyebrow}</p>
        <h2 class="t-h2 mt-2 text-fg">{d.menu.title}</h2>
      </div>
      {d.menu.lead && <p class="t-body max-w-xs">{d.menu.lead}</p>}
    </div>

    <!-- Masonry bento: the signature plate takes a 2×2 tile. Each price sits
         in a bite cut from the tile's top corner. -->
    <ul class="mt-8 grid auto-rows-[15rem] gap-3 sm:grid-cols-2 md:mt-12 lg:grid-cols-3 lg:auto-rows-[17rem]">
      {d.menu.dishes.map((dish, i) => (
        <li
          class:list={['window group rounded-se-none', i === 0 && 'sm:col-span-2 sm:row-span-2', i === 5 && 'sm:col-span-2 lg:col-span-1']}
          data-reveal
        >
          <Photo
            id={dish.photo.id}
            alt={dish.photo.alt}
            ratio="4/3"
            sizes={i === 0 ? '(min-width: 1024px) 64vw, (min-width: 640px) 92vw, 92vw' : '(min-width: 1024px) 32vw, (min-width: 640px) 46vw, 92vw'}
            class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-700 ease-fluid group-hover:scale-[1.04]"
          />
          <div class="veil"></div>
          <p class="bite bite-te t-price px-4 pt-2.5 pb-3 text-saffron [--r:1.25rem]">{formatPrice(locale, dish.price)}</p>
          <div class="absolute inset-x-0 bottom-0 p-5 md:p-6">
            <h3 class:list={['text-fg', i === 0 ? 't-h2' : 't-h3']}>{dish.name}</h3>
            <p class:list={['t-small mt-2 max-w-md text-fg/75', i !== 0 && 'line-clamp-2']}>{dish.desc}</p>
          </div>
        </li>
      ))}
    </ul>

    <p class="t-small mt-8" data-reveal>{d.menu.note}</p>
  </div>
</section>
