---
import Photo from '../Photo.astro';
import { getDict } from '../../lib/dict';
import type { Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
const [room, pass] = d.story.photos;
---
<section id="story" class="section-y">
  <div class="container-page grid gap-10 md:grid-cols-12 md:gap-8">
    <header class="md:col-span-4">
      <p class="t-eyebrow" data-reveal>{d.story.eyebrow}</p>
      <h2 class="t-h2 mt-3 text-fg" data-reveal>{d.story.title}</h2>
      <figure class="mt-8 hidden md:block" data-reveal>
        <div class="zoom overflow-hidden rounded-[0.5rem]">
          <Photo id={pass.id} alt={pass.alt} ratio="3/4" sizes="30vw" class="aspect-[3/4] w-full object-cover" />
        </div>
        <figcaption class="t-small mt-2 font-serif italic rtl:font-serif-ar rtl:not-italic">{d.story.caption}</figcaption>
      </figure>
    </header>

    <div class="md:col-span-7 md:col-start-6">
      <figure data-reveal="scale">
        <div class="zoom overflow-hidden rounded-[0.5rem]">
          <Photo id={room.id} alt={room.alt} ratio="4/3" sizes="(min-width: 768px) 55vw, 94vw" class="aspect-[4/3] w-full object-cover" />
        </div>
      </figure>
      <!-- Newspaper columns on wide screens, a drop cap to open. -->
      <div class="mt-8 gap-8 md:columns-2">
        {d.story.paragraphs.map((p, i) => (
          <p
            class:list={['t-body mb-4 break-inside-avoid text-fg', i === 0 && 'ltr:first-letter:float-start ltr:first-letter:me-2 ltr:first-letter:font-serif ltr:first-letter:text-7xl ltr:first-letter:leading-[0.8] ltr:first-letter:text-saffron-deep']}
            data-reveal
          >{p}</p>
        ))}
      </div>
      <p class="t-small mt-2 font-serif italic md:hidden rtl:font-serif-ar rtl:not-italic">— {d.story.caption}</p>
    </div>
  </div>
</section>
