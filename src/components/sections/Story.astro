---
import Photo from '../Photo.astro';
import { getDict } from '../../lib/dict';
import type { Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
const [wide, close] = d.story.photos;
---
<section id="story" class="section-y">
  <div class="container-page">
    <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16">
      <!-- Text first in the DOM, so mobile reads the story before the photos. -->
      <div>
        <p class="t-eyebrow" data-reveal>{d.story.eyebrow}</p>
        <h2 class="t-h2 mt-2 text-fg" data-reveal>{d.story.title}</h2>
        <div class="mt-8 space-y-4">
          {d.story.paragraphs.map((p) => <p class="t-body" data-reveal>{p}</p>)}
        </div>
        <p class="t-small mt-8 inline-flex rounded-full bg-surface px-4 py-2 text-saffron" data-reveal>{d.story.caption}</p>
      </div>

      <!-- Overlap stack: a tall window, and a smaller photo laid over its
           corner, slightly turned and ringed in the page colour. -->
      <div class="relative pb-16 md:pb-20" data-reveal="scale">
        <div class="window aspect-[3/4] w-[80%]">
          <Photo id={wide.id} alt={wide.alt} ratio="3/4" sizes="(min-width: 768px) 36vw, 76vw" class="size-full object-cover" />
        </div>
        <div class="absolute end-0 bottom-0 w-[50%] rotate-3 rounded-[1.75rem] bg-ink p-2 rtl:-rotate-3">
          <div class="aspect-[3/4] overflow-hidden rounded-[1.25rem]">
            <Photo id={close.id} alt={close.alt} ratio="3/4" sizes="(min-width: 768px) 22vw, 46vw" class="size-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
