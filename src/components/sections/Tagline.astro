---
import Icon from '../Icon.astro';
import { getDict } from '../../lib/dict';
import type { Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);

// Words are split for presentation only. The whole sentence is exposed to
// assistive tech via aria-label on the <p>, and the spans are hidden from it,
// so a screen reader reads continuous prose rather than disconnected words.
const lines = d.tagline.lines.map((line) => line.split(' '));
const full = d.tagline.lines.join(' ');
---
<!-- Surface band whose top edge dips in the middle around the saffron mark. -->
<section id="tagline" class="px-2 md:px-3">
  <div class="relative rounded-[2rem] bg-surface px-6 pt-28 pb-16 md:px-12 md:pt-32 md:pb-24">
    <div class="dip px-5 pb-4">
      <span class="flex size-14 items-center justify-center rounded-full bg-saffron text-ink">
        <Icon name="fork-knife" class="size-6" />
      </span>
    </div>
    <p class="t-tagline mx-auto max-w-4xl text-center text-fg" data-tagline aria-label={full}>
      {lines.map((words) => (
        <span class="block" aria-hidden="true">
          {words.map((word, wi) => (
            <>
              <span data-word>{word}</span>{wi < words.length - 1 ? ' ' : ''}
            </>
          ))}
        </span>
      ))}
    </p>
  </div>
</section>
