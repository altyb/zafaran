---
import { getDict } from '../../lib/dict';
import type { Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
---
<section id="faq" class="section-y pt-0">
  <div class="container-page grid gap-8 md:grid-cols-[1fr_2fr] md:gap-16">
    <div data-reveal>
      <p class="t-eyebrow">{d.faq.eyebrow}</p>
      <h2 class="t-h2 mt-3 text-fg">{d.faq.title}</h2>
    </div>

    <!-- A description list reads as question/answer pairs to assistive tech. -->
    <dl class="border-b rule">
      {d.faq.items.map((item) => (
        <div class="border-t rule" data-reveal>
          <details name="faq" class="faq-item">
            <summary class="flex cursor-pointer items-center gap-4 py-5">
              <dt class="t-faq-q flex-1 font-serif text-xl text-fg md:text-2xl rtl:font-serif-ar">{item.q}</dt>
              <span class="faq-plus relative size-5 shrink-0 text-saffron-deep" aria-hidden="true"></span>
            </summary>
            <dd class="t-body max-w-2xl pb-6">{item.a}</dd>
          </details>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* CSS-only accordion. No JavaScript: <details name> gives single-open for free. */
  .faq-item { interpolate-size: allow-keywords; }
  .faq-item summary { list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-plus::before, .faq-plus::after {
    content: ""; position: absolute; inset: 0; margin: auto; width: 100%; height: 2px; background: currentColor;
    transition: rotate var(--dur-fast) var(--ease-fluid);
  }
  .faq-plus::after { rotate: 90deg; }
  .faq-item[open] .faq-plus::after { rotate: 0deg; }

  .faq-item::details-content {
    block-size: 0; overflow: hidden;
    transition: block-size var(--dur-fast) var(--ease-fluid), content-visibility var(--dur-fast) allow-discrete;
  }
  .faq-item[open]::details-content { block-size: auto; }
  @media (prefers-reduced-motion: reduce) {
    .faq-plus::before, .faq-plus::after, .faq-item::details-content { transition: none; }
  }
</style>
