---
import { getDict } from '../../lib/dict';
import type { Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
---
<!-- A day in the kitchen as a timetable: huge times, ruled rows. The row in
     the middle of the screen lights up (reveal.ts toggles .is-now). -->
<section id="day" class="section-y bg-fg text-page/70">
  <div class="container-page">
    <p class="t-eyebrow !text-saffron" data-reveal>{d.day.eyebrow}</p>
    <h2 class="t-h2 mt-3 text-page" data-reveal>{d.day.title}</h2>

    <ol class="mt-10 md:mt-14">
      {d.day.steps.map((step) => (
        <li class="day-step grid grid-cols-[auto_1fr] items-baseline gap-x-5 border-t border-page/15 py-5 md:grid-cols-[16rem_1fr_1.2fr] md:gap-x-10 md:py-7" data-reveal>
          <time class="day-time font-serif text-5xl tabular-nums text-page/25 transition-colors duration-500 md:text-7xl" dir="ltr">{step.time}</time>
          <h3 class="t-h3 text-page">{step.title}</h3>
          <p class="t-body col-start-2 mt-1 md:col-start-3 md:mt-0">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .day-step.is-now .day-time { color: var(--color-saffron); }
</style>
