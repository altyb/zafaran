---
import Logo from './Logo.astro';
import { getDict, whatsappUrl, localePath } from '../lib/dict';
import { LOCALE_META, otherLocale, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);

const other = otherLocale(locale);
const otherMeta = LOCALE_META[other];
// The one place the page shows the other script, so it carries its own
// lang/dir and the matching family.
const otherFontClass = other === 'ar' ? 'font-arabic' : 'font-sans';
---
<!-- Masthead: links on the start side, the name in the middle, language and
     booking on the end side, a rule underneath. Turns to paper glass once
     the page scrolls (the script toggles .is-scrolled). -->
<header id="masthead" class="fixed inset-x-0 top-0 z-50 transition-colors duration-500">
  <nav aria-label={d.common.mainNav} class="container-page grid h-16 grid-cols-[1fr_auto_1fr] items-center gap-3 md:h-20">
    <ul class="hidden items-center gap-6 md:flex">
      {d.nav.links.map((link) => (
        <li><a href={link.href} class="t-nav text-fg-muted transition-colors duration-300 hover:text-fg">{link.label}</a></li>
      ))}
    </ul>
    <a
      href={localePath(other)}
      lang={other}
      dir={otherMeta.dir}
      class:list={['t-nav press justify-self-start text-fg underline decoration-fg/30 underline-offset-4 md:hidden', otherFontClass]}
    >{otherMeta.label}</a>

    <a href={localePath(locale)} aria-current="page" class="press text-fg"><Logo class="h-9 md:h-11" label={d.common.brand} /></a>

    <div class="flex items-center justify-self-end gap-5">
      <a
        href={localePath(other)}
        lang={other}
        dir={otherMeta.dir}
        class:list={['t-nav hidden text-fg-muted transition-colors duration-300 hover:text-fg md:inline', otherFontClass]}
      >{otherMeta.label}</a>
      <a href="#reserve" class="press rounded-full bg-fg px-4 py-2.5 text-sm font-semibold text-page md:px-5">{d.common.reserveShort}</a>
    </div>
  </nav>
  <div class="masthead-rule container-page"><div class="border-b rule"></div></div>
</header>

<style>
  #masthead.is-scrolled { background: var(--color-glass); backdrop-filter: blur(14px); }
  #masthead.is-scrolled .masthead-rule { opacity: 0; }
</style>
