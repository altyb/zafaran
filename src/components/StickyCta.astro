---
import Icon from './Icon.astro';
import { getDict, whatsappUrl, site } from '../lib/dict';
import type { Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = getDict(locale);
---
<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-glass p-4 backdrop-blur-xl md:hidden"
>
  <div class="flex items-center gap-4">
    <a
      href={whatsappUrl(locale)}
      target="_blank"
      rel="noopener"
      class="btn btn-primary flex-1"
    >
      {d.common.reserve}
      <Icon name="whatsapp-logo" class="size-4" />
    </a>
    <a
      href={`tel:${site.phoneE164}`}
      aria-label={d.common.call}
      class="btn btn-secondary size-12 shrink-0 px-0"
    >
      <Icon name="phone" class="size-5" />
    </a>
  </div>
</div>

<style>
  /* The script toggles .is-visible once the hero leaves the viewport. */
  #sticky-cta {
    padding-bottom: calc(1rem + env(safe-area-inset-bottom));
    translate: 0 100%;
    transition: translate var(--dur-fast) var(--ease-fluid);
  }
  #sticky-cta.is-visible { translate: 0 0; }
  @media (prefers-reduced-motion: reduce) { #sticky-cta { transition: none; } }
</style>
